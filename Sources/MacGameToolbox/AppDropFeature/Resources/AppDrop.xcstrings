    "notifications.submitted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitted to the system. Check Notification Center; banner display depends on your system settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已提交给系统。请查看通知中心，是否显示横幅取决于系统设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
