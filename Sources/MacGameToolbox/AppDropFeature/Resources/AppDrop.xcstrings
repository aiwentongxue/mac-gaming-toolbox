    "settings.changeAllResultMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated %d apps to %@; %d unchanged; %d kept in original region (unavailable or already tracked)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将 %d 款应用更改至 %@；%d 款无需更改；%d 款因未在目标地区上架或已存在而保留原地区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已將 %d 個 App 更新至 %@；%d 個未變更；%d 個保留原地區（無法取得或已追蹤）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 件を %@ に変更、%d 件は変更なし、%d 件は元の地域を維持（未提供または追跡済み）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 %d개를 %@로 변경, %d개 변경 없음, %d개는 기존 지역 유지(사용 불가 또는 이미 추적 중)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d Apps zu %@ gewechselt; %d unverändert; %d behalten ihre Region (nicht verfügbar oder bereits beobachtet)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d apps transférées vers %@ ; %d inchangées ; %d conservent leur région (indisponibles ou déjà suivies)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
