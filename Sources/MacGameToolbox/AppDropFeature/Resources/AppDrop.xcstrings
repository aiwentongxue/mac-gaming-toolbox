    "startup.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared local storage directory is not available. AppDrop refuses to create a different fallback database so that the app and the background helper always use one store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问共享的本地存储目录。为保证主应用与后台助手始终使用同一份数据，AppDrop 拒绝改用另一份回退数据库。"
          }
        }
      }
    },
    "startup.storageHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop stores its database in your user Library. Confirm that the Application Support folder is writable, then reopen the app. No Full Disk Access grant is required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop 将数据库保存在当前用户的资源库中。请确认 Application Support 目录可写，然后重新打开应用；该版本无需授予完全磁盘访问权限。"
          }
        }
      }
    },
