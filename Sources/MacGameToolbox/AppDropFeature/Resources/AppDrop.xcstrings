    "onboarding.region.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New apps use this storefront by default; you can pick a different one whenever you add an app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新添加的应用默认使用该区域，添加时可单独选择其他区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新加入的 App 預設使用此商店；每次加入時仍可選擇其他商店。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいAppにはこのストアを使います。追加時に別のストアを選ぶこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 앱은 기본적으로 이 스토어를 사용하며, 추가할 때 다른 스토어를 선택할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Apps verwenden standardmäßig diesen Store. Beim Hinzufügen kannst du einen anderen auswählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles apps utilisent cette boutique par défaut. Vous pouvez en choisir une autre à chaque ajout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
