    "settings.backend.requiresApprovalHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow AppDrop's background helper under System Settings → General → Login Items & Extensions, otherwise scheduled checks cannot run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 → 通用 → 登录项与扩展”中允许 AppDrop 的后台助手，否则定时检查无法运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定 → 一般 → 登入項目與延伸功能中允許 AppDrop 背景輔助程式，否則無法排程檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → 一般 → ログイン項目と機能拡張でAppDropのヘルパーを許可してください。許可しないと定期確認を実行できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 일반 → 로그인 항목 및 확장 프로그램에서 AppDrop 도우미를 허용하세요. 허용하지 않으면 예약 확인이 실행되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube das AppDrop-Hilfsprogramm unter Systemeinstellungen → Allgemein → Anmeldeobjekte & Erweiterungen. Sonst sind keine geplanten Prüfungen möglich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’assistant AppDrop dans Réglages Système → Général → Ouverture et extensions. Sinon, les vérifications planifiées ne pourront pas s’exécuter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el auxiliar de AppDrop en Ajustes del Sistema → General → Ítems de inicio y extensiones; de lo contrario, no se ejecutarán las comprobaciones programadas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o auxiliar do AppDrop em Ajustes do Sistema → Geral → Itens de Início e Extensões; caso contrário, as verificações agendadas não serão executadas."
          }
        }
      }
    },
