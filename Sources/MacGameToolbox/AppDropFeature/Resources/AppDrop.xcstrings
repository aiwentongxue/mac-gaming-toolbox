    "onboarding.background.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop registers a lightweight background helper that checks prices even when the main app is closed. macOS may show a second notification permission prompt for the helper."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop 会注册一个轻量后台助手，在主应用关闭时也能检查价格。系统可能会为助手单独弹出一次通知授权（“AppDrop Helper”）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop 會註冊輕量背景輔助程式，即使主程式關閉仍可檢查價格。macOS 可能另外要求輔助程式的通知權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDropは軽量のバックグラウンドヘルパーを登録し、Appを閉じている間も価格を確認します。macOSからヘルパーの通知許可を別途求められる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop은 앱을 닫아도 가격을 확인하는 가벼운 백그라운드 도우미를 등록합니다. macOS가 도우미의 알림 권한을 별도로 요청할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop registriert ein schlankes Hilfsprogramm, das Preise auch bei geschlossener App prüft. macOS fragt eventuell gesondert nach dessen Mitteilungserlaubnis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop enregistre un assistant léger qui vérifie les prix même lorsque l’app est fermée. macOS peut demander une autorisation de notifications distincte pour cet assistant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop registra un auxiliar ligero que comprueba precios con la app cerrada. macOS puede pedir un permiso de notificaciones adicional para el auxiliar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O AppDrop registra um auxiliar leve que verifica preços mesmo com o app fechado. O macOS pode pedir uma permissão de notificações separada para o auxiliar."
          }
        }
      }
    },
