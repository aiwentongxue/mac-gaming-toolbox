    "settings.backgroundNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "launchd runs the helper at most once every 24 hours and only while the Mac is awake; runs can be delayed or missed while the Mac sleeps or is off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "launchd 最多每 24 小时运行一次后台助手，且仅在 Mac 唤醒时执行；休眠或关机期间可能延迟或错过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "launchd 最多每 24 小時執行一次輔助程式，且僅在 Mac 喚醒時執行；睡眠或關機期間可能延遲或略過。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "launchdはMacのスリープ解除中に限り、最大24時間に1回ヘルパーを実行します。スリープ中や電源オフ中は実行が遅れたり省略されたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "launchd는 Mac이 깨어 있을 때 최대 24시간에 한 번 도우미를 실행합니다. 잠자기나 전원 꺼짐 중에는 지연되거나 누락될 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "launchd startet das Hilfsprogramm höchstens einmal pro 24 Stunden und nur bei wachem Mac. Im Ruhezustand oder bei ausgeschaltetem Mac können Läufe verzögert werden oder entfallen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "launchd exécute l’assistant au plus une fois par 24 heures, uniquement lorsque le Mac est éveillé. Les vérifications peuvent être retardées ou manquées pendant la veille ou l’arrêt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "launchd ejecuta el auxiliar como máximo una vez cada 24 horas y solo con el Mac despierto. Las comprobaciones pueden retrasarse u omitirse durante el reposo o apagado."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O launchd executa o auxiliar no máximo uma vez a cada 24 horas e apenas com o Mac desperto. Verificações podem atrasar ou ser perdidas durante o repouso ou desligamento."
          }
        }
      }
    },
