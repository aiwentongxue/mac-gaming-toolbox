        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird in diesem Store bereits beobachtet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà suivie dans cette boutique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya se sigue en esta tienda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já está sendo acompanhado nesta loja."
          }
        }
      }
    },
