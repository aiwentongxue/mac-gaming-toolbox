    "settings.changeAllConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will switch all apps not already in %@ to this storefront and refresh their prices. Apps not available in that storefront will keep their current region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会将所有未处于【%@】的应用切换至该地区，并重新获取价格与货币。目标地区未上架的应用将保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將目前不在 %@ 的 App 切換至此商店並更新價格。該商店未提供的 App 將保留原地區。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以外のAppをこのストアに変更し、価格を更新します。このストアにないAppは現在の地域を維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 이외의 앱을 이 스토어로 변경하고 가격을 새로 고칩니다. 해당 스토어에 없는 앱은 기존 지역을 유지합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Apps außerhalb von %@ wechseln zu diesem Store und ihre Preise werden aktualisiert. Nicht verfügbare Apps behalten ihre Region."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps qui ne sont pas dans %@ seront transférées vers cette boutique et leurs prix actualisés. Les apps indisponibles garderont leur région."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que no estén en %@ cambiarán a esta tienda y actualizarán sus precios. Las no disponibles conservarán su región."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que não estão em %@ serão alterados para esta loja e terão os preços atualizados. Os indisponíveis manterão a região atual."
          }
        }
      }
    },
