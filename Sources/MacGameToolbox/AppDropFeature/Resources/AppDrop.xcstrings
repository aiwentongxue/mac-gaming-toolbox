    "add.duplicateNamed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already tracked for this storefront."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已在追踪列表中（同一区域）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在此商店追蹤 %@。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このストアでは %@ をすでに追跡しています。"
