    "startup.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared local storage directory is not available. AppDrop refuses to create a different fallback database so that the app and the background helper always use one store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问共享的本地存储目录。为保证主应用与后台助手始终使用同一份数据，AppDrop 拒绝改用另一份回退数据库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共用本機儲存目錄無法使用。為確保 App 與背景輔助程式使用同一資料庫，AppDrop 不會建立其他備用資料庫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有ローカル保存先が使えません。Appとヘルパーが同じデータベースを使うため、別の場所にデータベースは作成しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 로컬 저장소를 사용할 수 없습니다. 앱과 도우미가 같은 저장소를 사용하도록 AppDrop은 대체 데이터베이스를 생성하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gemeinsame lokale Verzeichnis ist nicht verfügbar. AppDrop legt keine Ersatzdatenbank an, damit App und Hilfsprogramm denselben Speicher verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le répertoire local partagé est indisponible. AppDrop ne crée pas de base de secours afin que l’app et l’assistant utilisent toujours la même base."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El directorio local compartido no está disponible. AppDrop no creará otra base para que la app y el auxiliar usen siempre la misma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O diretório local compartilhado não está disponível. O AppDrop não cria outro banco para que o app e o auxiliar usem sempre o mesmo."
          }
        }
      }
    },
    "startup.storageHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop stores its database in your user Library. Confirm that the Application Support folder is writable, then reopen the app. No Full Disk Access grant is required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop 将数据库保存在当前用户的资源库中。请确认 Application Support 目录可写，然后重新打开应用；该版本无需授予完全磁盘访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop 將資料庫存於使用者的 Library。請確認 Application Support 資料夾可寫入後重新開啟 App。無需完全磁碟存取權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDropはユーザーのLibraryにデータベースを保存します。Application Supportフォルダに書き込めることを確認し、Appを開き直してください。フルディスクアクセスは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop은 사용자 Library에 데이터베이스를 저장합니다. Application Support 폴더에 쓸 수 있는지 확인한 후 앱을 다시 여세요. 전체 디스크 접근 권한은 필요하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop speichert die Datenbank in deiner Library. Prüfe, ob Application Support beschreibbar ist, und öffne die App erneut. Festplattenvollzugriff ist nicht erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop stocke sa base dans votre dossier Library. Vérifiez que le dossier Application Support est accessible en écriture, puis rouvrez l’app. L’accès complet au disque n’est pas nécessaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop guarda la base en tu Library. Comprueba que se puede escribir en Application Support y vuelve a abrir la app. No requiere acceso total al disco."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O AppDrop armazena o banco na sua Library. Confirme que Application Support permite gravação e reabra o app. Não é necessário acesso total ao disco."
          }
        }
      }
    },
