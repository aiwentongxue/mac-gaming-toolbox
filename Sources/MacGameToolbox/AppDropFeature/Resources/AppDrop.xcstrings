        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템에 제출했습니다. 알림 센터를 확인하세요. 배너 표시는 시스템 설정에 따라 달라집니다."
          }
        },
        "de": {
          "stringUnit": {
