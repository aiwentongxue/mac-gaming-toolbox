    "detail.changeRegion.duplicate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is already tracked in the selected storefront."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该应用在所选区域已在追踪列表中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在所選商店追蹤此 App。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したストアではこのAppをすでに追跡しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 스토어에서 이 앱을 이미 추적 중입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App wird im ausgewählten Store bereits beobachtet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app est déjà suivie dans la boutique sélectionnée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app ya se sigue en la tienda seleccionada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app já é acompanhado na loja selecionada."
          }
        }
      }
    },
    "detail.changeRegionMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The price history of the current storefront will be cleared and a new baseline will be created for the new storefront."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前区域的价格历史将被清除，并按新区域重新建档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將清除此 App 在目前商店的價格記錄，並為新商店建立新的基準價格。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のストアの価格履歴を削除し、新しいストアで基準価格を記録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 스토어의 가격 기록이 지워지고 새 스토어의 기준 가격이 생성됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Preisverlauf des aktuellen Stores wird gelöscht und für den neuen Store ein neuer Ausgangspreis erfasst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique des prix de la boutique actuelle sera effacé et un nouveau prix de référence sera créé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrará el historial de la tienda actual y se creará un precio de referencia en la nueva tienda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico da loja atual será apagado e um novo preço de referência será criado na nova loja."
          }
        }
      }
    },
