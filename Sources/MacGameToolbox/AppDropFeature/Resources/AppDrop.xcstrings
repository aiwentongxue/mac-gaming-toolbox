    "add.search.indexGapHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's search index does not include every app (some recently released Mac apps are missing). You can add such apps by pasting their App Store link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 的搜索索引并不包含全部应用（部分新上架的 Mac 应用搜不到），这类应用可以直接粘贴 App Store 链接添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 的搜尋索引未涵蓋所有 App（部分新推出的 Mac App 可能缺漏）。可貼上 App Store 連結加入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleの検索にはすべてのAppが含まれるわけではありません（新しいMac用Appなど）。見つからない場合はApp Storeリンクで追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 검색에는 모든 앱이 포함되지 않습니다(일부 최신 Mac 앱 등). App Store 링크를 붙여넣어 추가할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples Suchindex enthält nicht jede App, etwa einige neue Mac-Apps. Fehlende Apps lassen sich über ihren App-Store-Link hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’index de recherche Apple ne contient pas toutes les apps, notamment certaines apps Mac récentes. Ajoutez-les en collant leur lien App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El índice de Apple no incluye todas las apps, como algunas apps recientes para Mac. Puedes añadirlas pegando su enlace del App Store."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca da Apple não inclui todos os apps, como alguns apps recentes para Mac. Você pode adicioná-los colando o link da App Store."
          }
        }
      }
    },
