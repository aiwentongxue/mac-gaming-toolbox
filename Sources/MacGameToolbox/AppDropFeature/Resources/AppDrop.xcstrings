    "onboarding.welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track App Store prices across 17 storefronts (US, UK, Japan, South Korea, Germany and more), review price history and get notified when prices drop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "追踪 17 个商店区域（美国、英国、日本、韩国、德国等）的应用价格，查看历史走势，并在降价时收到提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤 17 個 App Store 商店的價格（美國、英國、日本、韓國、德國等），查看價格記錄並接收降價通知。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "米国、英国、日本、韓国、ドイツなど17のApp Storeで価格を追跡し、価格履歴の確認や値下げ通知を利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미국, 영국, 일본, 한국, 독일 등 17개 App Store의 가격을 추적하고 가격 기록과 인하 알림을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beobachte Preise in 17 App-Store-Regionen, darunter USA, Großbritannien, Japan, Südkorea und Deutschland. Sieh den Preisverlauf und erhalte Mitteilungen bei Preissenkungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez les prix dans 17 boutiques App Store, dont les États-Unis, le Royaume-Uni, le Japon, la Corée du Sud et l’Allemagne, consultez l’historique et recevez les alertes de baisse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue precios en 17 tiendas del App Store, como Estados Unidos, Reino Unido, Japón, Corea del Sur y Alemania, consulta el historial y recibe avisos de bajadas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe preços em 17 lojas da App Store, como EUA, Reino Unido, Japão, Coreia do Sul e Alemanha, consulte o histórico e receba alertas de queda."
          }
        }
      }
    },
