    "settings.defaultRegionCaption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default region only affects newly added apps. To change globally, use the option on the right."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认区域仅影响新添加的应用，如需全局更改请点击右侧选项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設地區僅影響新加入的 App。若要全部更改，請使用右側選項。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルト地域は新しく追加するAppにのみ適用されます。一括変更は右のボタンを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 지역은 새로 추가하는 앱에만 적용됩니다. 모두 변경하려면 오른쪽 옵션을 사용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standardregion gilt nur für neue Apps. Für eine globale Änderung verwende die Option rechts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La région par défaut ne concerne que les nouvelles apps. Pour tout modifier, utilisez l’option à droite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La región predeterminada solo afecta a nuevas apps. Para cambiarlas todas, usa la opción de la derecha."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A região padrão só afeta novos apps. Para alterar todos, use a opção à direita."
          }
        }
      }
    },
    "settings.helperPermissionHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background helper requests its own notification permission the first time it runs. Notifications it sends use that permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台助手首次运行时会请求独立的通知权限，由它发送的提醒使用该权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景輔助程式首次執行時會另外要求通知權限，其發送的通知使用該權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルパーは初回実行時に独自の通知許可を要求します。ヘルパーの通知にはその許可が使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 도우미는 처음 실행될 때 별도의 알림 권한을 요청하며, 해당 권한으로 알림을 보냅니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hilfsprogramm fragt beim ersten Start nach einer eigenen Mitteilungserlaubnis. Seine Mitteilungen verwenden diese Erlaubnis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant demande sa propre autorisation de notifications au premier lancement. Ses notifications utilisent cette autorisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El auxiliar pide su propio permiso de notificaciones al ejecutarse por primera vez y lo usa para enviar avisos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O auxiliar pede sua própria permissão de notificações na primeira execução e a usa para enviar avisos."
          }
        }
      }
    },
