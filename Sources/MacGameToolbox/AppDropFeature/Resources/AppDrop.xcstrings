    "onboarding.notifications.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop uses local notifications for price drops. You can skip this step and enable it later in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop 通过系统本地通知提醒降价，可跳过此步骤并在设置中随时开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop 使用本機通知提示降價。你可以略過此步驟，稍後在設定中啟用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDropはローカル通知で値下げをお知らせします。この手順をスキップし、後で設定から有効にすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop은 로컬 알림으로 가격 인하를 알립니다. 이 단계를 건너뛰고 나중에 설정에서 활성화할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop meldet Preissenkungen über lokale Mitteilungen. Du kannst diesen Schritt überspringen und sie später in den Einstellungen aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop utilise des notifications locales pour les baisses de prix. Vous pouvez ignorer cette étape et les activer plus tard dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AppDrop usa notificaciones locales para avisar de bajadas. Puedes omitir este paso y activarlas después en Ajustes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O AppDrop usa notificações locais para quedas de preço. Você pode pular esta etapa e ativá-las depois nos ajustes."
          }
        }
      }
    },
